{
  "name": "dentpro-colombia",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "build": "node scripts/run-ci-command.mjs \"prisma generate && next build --webpack\"",
    "analyze": "cross-env ANALYZE=true node scripts/run-ci-command.mjs \"prisma generate && next build --webpack\"",
    "vercel-build": "pnpm exec prisma generate --schema prisma/schema.prisma && node scripts/vercel-prisma.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/run-ci-command.mjs \"vitest run\"",
    "e2e": "pnpm run test:e2e",
    "prisma": "prisma",
    "db:seed": "prisma db seed",
    "prisma:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "postinstall": "node scripts/prisma-generate-safe.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e:prod": "E2E_ENV=production RUN_E2E=1 pnpm run test:e2e",
    "e2e:smoke": "RUN_E2E=1 E2E_SUITE=smoke pnpm run test:e2e",
    "e2e:full": "RUN_E2E=1 E2E_SUITE=full pnpm run test:e2e"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.7.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "motion": "^13.1.1",
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "rrule": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "@playwright/test": "^1.62.1",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "baseline-browser-mapping": "^2.11.13",
    "cross-env": "10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.9.0",
    "jsdom": "30.0.1",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "cookie": "0.7.2",
    "diff": "8.0.3",
    "hono": "4.11.4"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "overrides": {
      "@auth/core": "0.41.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@sentry/cli",
      "better-sqlite3",
      "unrs-resolver"
    ]
  }
}
