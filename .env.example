GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTO_CREATE_PATIENTS="true"
NEXT_PUBLIC_APP_URL=""

RESEND_API_KEY=""
EMAIL_FROM=""
# SMTP config for appointment emails.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Secret for appointment reminder cron authorization.
CRON_SECRET=""

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

ANALYTICS_TIME_ZONE=""
CLINIC_NAME=""
CLINIC_CITY=""
CLINIC_ADDRESS=""

TEST_AUTH_BYPASS=""
TEST_AUTH_EMAIL=""
TEST_AUTH_PASSWORD=""
TEST_AUTH_ROLE=""

# Obligatorio en producción: sin Upstash el login falla cerrado (503) para no quedar sin límite
# de intentos. También se aceptan KV_REST_API_URL / KV_REST_API_TOKEN (integración de Vercel).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel Blob (DOG-54): dos stores, porque el acceso público o privado es del store.
# Privado, para adjuntos clínicos (store dentpro-clinico).
BLOB_READ_WRITE_TOKEN=""
# Público, para imágenes del CMS (store dentpro-cms).
CMS_BLOB_READ_WRITE_TOKEN=""

# URL pública del sitio (canonical, sitemap, JSON-LD). Por defecto: https://dent-pro-colombia.vercel.app
NEXT_PUBLIC_SITE_URL=""

# Sentry: en Vercel, SENTRY_DSN del proyecto dogbyte/dentpro-colombia. Vacío en local: Sentry apagado.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Token required for the local/internal Sentry monitoring test trigger.
MONITORING_TEST_TOKEN=""
# Controls application log verbosity in production (recommend info or warn).
LOG_LEVEL="info"

RUN_E2E=""
PLAYWRIGHT_BROWSERS_PATH=""

# Optional: set to 1 to disable Next.js telemetry in CI/logs.
NEXT_TELEMETRY_DISABLED=""

GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""

# Cifrado de datos sensibles en reposo (DOG-18). Claves de 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sin FIELD_ENCRYPTION_KEY los datos se guardan en claro (modo transición).
# FIELD_HASH_KEY no rota: cambiarla obliga a recalcular los hashes de documento.
FIELD_ENCRYPTION_KEY=""
FIELD_ENCRYPTION_KEY_ID="k1"
# Claves anteriores tras una rotación, para poder descifrar: "k0:base64,..."
FIELD_ENCRYPTION_PREVIOUS_KEYS=""
FIELD_HASH_KEY=""
